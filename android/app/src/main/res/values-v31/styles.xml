<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ splash screen.

      From API 31 the system draws the splash itself and IGNORES
      `android:background="@drawable/splash"` on the launch theme — without this
      file the app falls back to the bare launcher icon on a default background,
      which is why a perfectly good splash.png can look like it was never set.

      `windowSplashScreenAnimatedIcon` must be a vector or the system will not
      mask it correctly, hence `splash_icon.xml` rather than the PNG the older
      API levels use.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
