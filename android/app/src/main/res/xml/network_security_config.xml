<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext (http://) traffic by default from API 28 onward, and
  this app targets 36 — so a dev backend on http://10.0.2.2:5000 is refused
  before the request ever leaves the WebView, which surfaces in the app as a
  plain "Cannot reach the server".

  Cleartext is therefore allowed for development hosts ONLY. The default stays
  `cleartextTrafficPermitted="false"`, so the deployed API (https, on Azure) and
  every other host keep full TLS enforcement — this is deliberately not
  `android:usesCleartextTraffic="true"` on the manifest, which would permit
  cleartext to *any* host in a shipped build.

  Add a host here if you serve the API from somewhere else over http, e.g. a
  different LAN IP than the one below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- This dev machine on Wi-Fi, for running on a real device. -->
        <domain includeSubdomains="false">192.168.1.5</domain>
        <!-- The WebView's own origin; Capacitor serves the bundle from here. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
