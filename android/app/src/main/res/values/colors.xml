<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <color name="colorPrimary">#6366F1</color>
    <color name="colorPrimaryDark">#4F46E5</color>
    <color name="colorAccent">#8B5CF6</color>
    <!-- NOTE: ic_launcher_background is deliberately NOT declared here — it
         already lives in values/ic_launcher_background.xml, and declaring it
         twice is a duplicate-resource build failure. -->
    <!-- Android 12+ splash background. White, matching the legacy splash.png so
         both API paths look identical. -->
    <color name="splashBackground">#FFFFFF</color>
    <!-- Status bar. Matches the app background (the "bg" custom property in
         global.css), so the bar reads as part of the app rather than as a
         strip above it. Keep in step with STATUS_BAR_COLOR in
         src/native/androidShell.js: the theme paints this before the WebView
         boots, the StatusBar plugin repaints it after.
         NOTE: a double hyphen is illegal inside an XML comment and fails the
         resource merger, so no CSS variable syntax here. -->
    <color name="statusBarBackground">#F4F6FB</color>
</resources>
