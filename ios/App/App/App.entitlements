<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability.

	  `development` is correct for BOTH debug and TestFlight/App Store builds:
	  Apple's App Store submission process rewrites it to `production`
	  automatically, whereas hardcoding `production` breaks push on every
	  development build. This is the value Xcode itself writes when you tick
	  "Push Notifications" on the target.

	  ⚠️ THE APP ID MUST HAVE PUSH ENABLED IN THE APPLE DEVELOPER PORTAL, or the
	  provisioning profile will not carry this entitlement and the signed build
	  fails with "Provisioning profile doesn't match the entitlements file".
	  Enabling the capability here is only half of it.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
